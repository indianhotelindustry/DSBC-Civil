# ===============================================================
# Firebase Configuration
# ===============================================================
# REQUIRED in all environments. The committed firebase-applet-config.json
# dev fallback contains empty placeholders only — the app cannot reach
# Firebase until these are set (see docs/FIREBASE_MIGRATION.md).
#
# These are client-side keys (safe to expose in browser bundles).
# Security is enforced by Firestore rules and Firebase Auth.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# If using a non-default (named) Firestore database:
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# ===============================================================
# Development-only flags (ignored in production builds)
# ===============================================================

# Set to "true" to enable anonymous dev login button on the login page
VITE_ENABLE_DEV_LOGIN="false"

# ⚠️ DO NOT SET TO "true" — HALF-WIRED AND ACTIVELY HARMFUL (verified 2026-07-30, NN-21).
#
# What is wired:     src/services/auth.ts:18-20 calls connectAuthEmulator(auth,
#                    'http://localhost:9099') when DEV && this flag === 'true'.
# What is NOT wired: there is no connectFirestoreEmulator call anywhere in src/.
#                    Firestore ALWAYS points at the real cloud project.
# Also missing:      firebase.json declares only the FIRESTORE emulator (port 8085).
#                    No "auth" emulator is declared, so `firebase emulators:start`
#                    never starts anything on 9099.
#
# Setting this to "true" therefore produces one of two broken states:
#   1. No Auth emulator running  -> sign-in fails outright (connection refused).
#   2. Auth emulator started manually -> you authenticate as an emulator user whose
#      uid does not exist in the REAL Firestore `users` collection. Every rule does
#      get(/users/$(request.auth.uid)) to resolve the role, that read finds nothing,
#      and EVERY role-gated operation is denied. The app looks catastrophically broken.
#
# Leave it "false". Local end-to-end QA needs a provisioned Firebase project
# (staging) — see FIREBASE_PROVISIONING_GUIDE.md. Completing emulator support is a
# documented RECOMMENDATION (add connectFirestoreEmulator + an auth emulator entry in
# firebase.json + align ports); it is NOT implemented and needs approval.
#
# Unrelated and unaffected: the rules test suite (`npm run test:rules`) talks to the
# Firestore emulator directly via @firebase/rules-unit-testing and ignores this flag.
VITE_USE_FIREBASE_EMULATOR="false"

# Secure-API client fallback (Platform Stabilization v1.1).
# Production default is "false" — financial operations must go through the
# deployed backend; a failed server surfaces an error, not a client write.
# Set to "true" ONLY as an emergency rollback while the backend is unavailable.
VITE_ALLOW_CLIENT_FALLBACK="false"
