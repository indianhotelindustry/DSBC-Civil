# ===============================================================
# Firebase Configuration
# ===============================================================
# REQUIRED in all environments. The committed firebase-applet-config.json
# dev fallback contains empty placeholders only — the app cannot reach
# Firebase until these are set (see docs/FIREBASE_MIGRATION.md).
#
# These are client-side keys (safe to expose in browser bundles).
# Security is enforced by Firestore rules and Firebase Auth.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# If using a non-default (named) Firestore database:
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# ===============================================================
# Development-only flags (ignored in production builds)
# ===============================================================

# Set to "true" to enable anonymous dev login button on the login page
VITE_ENABLE_DEV_LOGIN="false"

# Set to "true" to connect to Firebase Auth emulator at localhost:9099
VITE_USE_FIREBASE_EMULATOR="false"

# Secure-API client fallback (Platform Stabilization v1.1).
# Production default is "false" — financial operations must go through the
# deployed backend; a failed server surfaces an error, not a client write.
# Set to "true" ONLY as an emergency rollback while the backend is unavailable.
VITE_ALLOW_CLIENT_FALLBACK="false"
